# Make Option key behave as Alt for terminal apps
macos-option-as-alt = left

# Fix Option+Backspace to delete word
keybind = opt+backspace=text:\x1b\x7f

# Shift+Enter sends ESC+CR (newline without submit, e.g. in Claude Code)
keybind = shift+enter=text:\x1b\r

# Color theme
theme = Catppuccin Mocha

# Window padding so text doesn't touch the edges
window-padding-x = 10
window-padding-y = 10

# Slightly translucent background with frosted blur
background-opacity = 0.95
background-blur-radius = 20

# Thin, non-blinking bar cursor
cursor-style = bar
cursor-style-blink = false

# Font size (default is 13)
font-size = 14

# Selecting text copies it to the clipboard
copy-on-select = clipboard

# Hide the mouse pointer while typing
mouse-hide-while-typing = true

# Compact title bar with tabs inside it
macos-titlebar-style = tabs

# Dim splits that don't have focus
unfocused-split-opacity = 0.85

# Keyboard scrolling: Cmd+Shift+Up/Down scrolls 5 lines at a time.
# (Inside tmux use plain Shift+Up/Down instead - tmux keeps its own scrollback.)
# (replaces a duplicate jump_to_prompt binding; Cmd+Up/Down still does that)
keybind = cmd+shift+arrow_up=scroll_page_lines:-5
keybind = cmd+shift+arrow_down=scroll_page_lines:5

# Keep more history (default ~10 MB) - Claude Code prints a lot
scrollback-limit = 50000000

# Use the wider Display P3 color space for more vivid colors on Mac screens
window-colorspace = display-p3
